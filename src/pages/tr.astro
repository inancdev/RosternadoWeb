---
/**
 * Turkish home page (/tr.html). A shorter companion to the English home page, not a
 * line-by-line translation — it exists so Turkish searches ("pegasus roster",
 * "thy roster uygulaması") land on Turkish copy. Pricing, support and legal pages
 * stay English-only.
 */
import { Picture, Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PhoneFrame from '../components/PhoneFrame.astro';
import StoreButtons from '../components/StoreButtons.astro';
import { airlinePages, requestMailto } from '../content/airlines';

import a320 from '../assets/brand/a320.png';
import cloud1 from '../assets/brand/02.webp';
import cloud2 from '../assets/brand/06.webp';
import cloud3 from '../assets/brand/09.webp';
import roster from '../assets/shots/roster.png';

const shot = {
  formats: ['avif', 'webp'] as const,
  fallbackFormat: 'webp' as const,
  widths: [300, 600, 900],
};
const trAirlines = airlinePages.filter((p) => p.tr);

const features = [
  ['Tek dokunuşla roster aktarımı', "Havayolunuzun roster sitesini uygulama içinde açın, giriş yapın ve kaydedin. Görevler ayrıştırılıp sizin için düzenlenir — tarih kopyalamak yok, PDF'ten yeniden yazmak yok."],
  ['Tek liste, renk kodlu', 'Uçuş, standby, eğitim, izin günü, yıllık izin ve ofis görevleri kronolojik tek bir listede. Çok ayaklı uçuşlar tek kartta toplanır.'],
  ['Friend Radar', 'Bir arkadaşınız uçarken onu uçuşu ve tahmini varış saatiyle haritada görün. Konumlar yaklaşıktır; aile ve arkadaşlar içindir, takip servisi değildir.'],
  ['Buluşma planlayıcı', 'Birkaç ekip arkadaşı seçin; Rosternado herkesin rosterını okuyup hepinizin aynı anda, aynı yerde boş olduğu aralıkları yerel saatleriyle bulur.'],
  ['Çevrimdışı çalışır', 'Rosterınız cihazınızda saklanır; sinyal yokken, uçuş sırasında bile açılır.'],
  ['Arkadaş ve aile', 'Ekip değil misiniz? Bir ekip üyesinin rosterını ücretsiz takip edin; ne zaman uçtuğunu, indiğini ya da evde olduğunu her zaman bilin.'],
] as const;

const faq = [
  ['Hangi havayolları destekleniyor?', 'Pegasus, AJet, Türk Hava Yolları ve SunExpress gerçek rosterlarla doğrulandı. CAE ekip portalını kullanan 15 havayolu daha beta aşamasında. Yaklaşık 75 havayolu için de görevler elle girilebilir.'],
  ['Rosterımı kim görebilir?', 'Yalnızca kabul ettiğiniz arkadaşlar. Rosterlar varsayılan olarak gizlidir ve aramada asla görünmez.'],
  ['Rosternado ücretsiz mi?', 'Bir arkadaşın rosterını takip etmek sonsuza kadar ücretsiz. Ücretsiz ekip hesabında bir roster aktarımı ve ayda 5 görev işlemi var. Pro aylık $2 veya yıllık $20; aktarım ve işlemler sınırsız.'],
  ['Reklam veya takip var mı?', 'Hayır. Uygulamada reklam, analitik ya da takip SDK’sı yok; bu web sitesi de üçüncü taraf script, font veya izleyici yüklemiyor.'],
] as const;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Rosternado',
  operatingSystem: 'iOS, Android',
  applicationCategory: 'TravelApplication',
  inLanguage: 'tr',
  description:
    'Rosternado, havayolu ekipleri için bir roster uygulamasıdır. Rosterınızı aktarın, uçuşlarınızı takip edin ve programınızı arkadaşlarınız ve ailenizle paylaşın.',
  url: 'https://rosternado.com/tr.html',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  sameAs: [
    'https://apps.apple.com/app/rosternado/6766887800',
    'https://play.google.com/store/apps/details?id=com.inancatil.rosternado',
  ],
};
---

<Layout
  title="Rosternado — Havayolu ekipleri için roster uygulaması"
  description="Rosternado, pilotlar ve kabin ekibi için bir roster uygulamasıdır. Rosterınızı havayolunuzdan aktarın, uçuşlarınızı takip edin, programınızı arkadaşlarınız ve ailenizle paylaşın."
  lang="tr"
  alternate="/"
  wide
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <section class="hero">
    <div class="hero__sky" aria-hidden="true">
      <Image src={cloud1} alt="" class="cloud cloud--1" width={560} loading="eager" />
      <Image src={cloud2} alt="" class="cloud cloud--2" width={560} loading="eager" />
      <Image src={cloud3} alt="" class="cloud cloud--3" width={560} loading="eager" />
      <Image src={a320} alt="" class="hero__plane" width={760} loading="eager" />
    </div>

    <div class="wrap hero__inner">
      <div class="hero__copy">
        <h1>Ekipler için roster paylaşımı</h1>
        <p class="lede">
          Rosternado uçuş programınızı tek yerde tutar — havayolunuzdan aktarın, tüm
          görevlerinizi bir bakışta görün ve nerede olduğunuzu merak edenlerle paylaşın.
        </p>
        <StoreButtons align="start" lang="tr" />
        <p class="hero__meta">Ücretsiz. Reklam yok, analitik yok, takip yok.</p>
      </div>

      <PhoneFrame class="hero__phone">
        <Picture
          src={roster}
          {...shot}
          sizes="(max-width: 900px) 266px, 326px"
          alt="Rosternado roster ekranı: İstanbul'dan Londra ve Beyrut uçuşları, simülatör kontrolü, tehlikeli madde eğitimi ve yıllık izinle iki haftalık görevler."
          loading="eager"
          fetchpriority="high"
        />
      </PhoneFrame>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="section-head section-head--center">
        <p class="eyebrow">Neler sunuyor</p>
        <h2>Rosterınız, sade ve paylaşılabilir</h2>
      </div>
      <div class="cards">
        {
          features.map(([h, p]) => (
            <article class="card">
              <h3>{h}</h3>
              <p>{p}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="band band--alt">
    <div class="wrap wrap--narrow">
      <div class="section-head section-head--center">
        <p class="eyebrow">Havayolları</p>
        <h2>Türk havayolları için doğrulandı</h2>
        <p class="lede">
          Pegasus, THY, AJet ve SunExpress rosterları gerçek rosterlarla test edildi.
        </p>
      </div>
      <ul class="airline-list">
        {
          trAirlines.map((p) => (
            <li class="airline">
              <span class="airline__code">{p.code}</span>
              <a class="airline__name" href={`/tr/airlines/${p.slug}.html`}>{p.tr!.name}</a>
            </li>
          ))
        }
      </ul>
      <p class="center-note"><a href="/tr/airlines.html">Tüm desteklenen havayolları</a></p>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="section-head section-head--center">
        <p class="eyebrow">Fiyatlar</p>
        <h2>Takip etmek ücretsiz, uçmak ucuz</h2>
      </div>
      <div class="cards cards--3">
        <article class="card">
          <h3>Arkadaş ve aile</h3>
          <p class="price">Sonsuza kadar ücretsiz</p>
          <p>Bir ekip arkadaşının rosterını takip edin. Aktarım yok.</p>
        </article>
        <article class="card">
          <h3>Ekip — Ücretsiz</h3>
          <p class="price">Ücretsiz</p>
          <p>Ayda 5 görev işlemi, bir roster aktarımı, sınırsız görüntüleme.</p>
        </article>
        <article class="card card--accent">
          <h3>Ekip — Pro</h3>
          <p class="price">$2 <span>/ ay</span></p>
          <p>Ya da yıllık $20. Sınırsız işlem ve aktarım.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="band band--alt">
    <div class="wrap wrap--narrow">
      <div class="section-head section-head--center">
        <h2>Sık sorulan sorular</h2>
      </div>
      <div class="card faq">
        {
          faq.map(([q, a]) => (
            <div class="faq__item">
              <h3>{q}</h3>
              <p>{a}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap wrap--narrow">
      <div class="cta-card">
        <h2>Havayolunuzun eklenmesini mi istiyorsunuz?</h2>
        <p>
          Roster aktarımı havayolu havayolu geliştiriliyor. <strong>Havayolu adını</strong>,
          giriş yaptığınız <strong>roster web sitesini</strong> ve
          <strong>roster sayfanızın bir ekran görüntüsünü</strong> gönderin.
        </p>
        <a class="btn" href={requestMailto}>Havayolunuzu talep edin</a>
      </div>
    </div>
  </section>

  <section class="band band--alt band--close">
    <div class="wrap">
      <div class="section-head section-head--center">
        <h2>Rosternado'yu edinin</h2>
        <p class="lede">iOS ve Android'de ücretsiz.</p>
      </div>
      <StoreButtons lang="tr" />
    </div>
  </section>
</Layout>

<style>
  .faq__item + .faq__item {
    margin-top: 1.1rem;
  }

  .faq h3 {
    font-size: var(--step-0);
    font-weight: 600;
    margin-bottom: 0.2rem;
  }

  .faq p {
    color: var(--text-dim);
    font-size: var(--step--1);
  }
</style>
