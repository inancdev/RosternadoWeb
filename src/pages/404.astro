---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page not found — Rosternado"
  description="That page doesn't exist. Head back to rosternado.com."
>
  <div class="wrap wrap--narrow page notfound">
    <p class="eyebrow">404</p>
    <h1>Nothing at this gate</h1>
    <p class="lede">
      That page doesn't exist — it may have been moved or the link may be mistyped.
    </p>
    <p>
      <a class="btn" href="/">Back to the home page</a>
    </p>
  </div>
</Layout>
