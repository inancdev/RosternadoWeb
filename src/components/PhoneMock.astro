---
/**
 * A drawn Android phone for step illustrations — the phone counterpart of
 * BrowserMock. Everything inside is fictional ("Example Air"). Exposed to screen
 * readers as one image with `label`; the page carries the instructions as text.
 */
interface Props {
  /** Address shown in the browser bar. Omit for no bar. */
  url?: string;
  /** Highlighted text typed in front of the address, e.g. "view-source:". */
  prefix?: string;
  label: string;
  class?: string;
}

const { url, prefix, label, class: className } = Astro.props;
---

<div class:list={['pm', className]} role="img" aria-label={label}>
  <div class="pm__screen">
    <div class="pm__status"><span>9:41</span><span class="pm__icons"><i></i><i></i><i></i></span></div>
    {url && <div class="pm__bar"><span class="pm__url">{prefix && <mark>{prefix}</mark>}{url}</span></div>}
    <div class="pm__body">
      <slot />
    </div>
  </div>
</div>

<style>
  .pm {
    aspect-ratio: 9 / 18.5;
    border-radius: 22px;
    padding: 5px;
    background: #1b2148;
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow:
      0 20px 44px -20px rgba(0, 0, 0, 0.7),
      0 4px 12px rgba(0, 0, 0, 0.3);
    font-size: 0.6rem;
    line-height: 1.35;
  }

  .pm__screen {
    height: 100%;
    display: flex;
    flex-direction: column;
    border-radius: 18px;
    overflow: hidden;
    background: #f5f6fa;
    color: #1d2340;
  }

  .pm__status {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.35rem 0.8rem 0.2rem;
    font-weight: 600;
    font-size: 0.55rem;
  }

  .pm__icons {
    display: flex;
    gap: 0.2rem;
  }

  .pm__icons i {
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    background: #1d2340;
    opacity: 0.55;
  }

  .pm__bar {
    padding: 0.2rem 0.45rem 0.4rem;
  }

  .pm__url {
    display: block;
    background: #e3e6f0;
    border-radius: 999px;
    padding: 0.25rem 0.6rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .pm__url mark {
    background: rgba(245, 158, 11, 0.3);
    color: #7a4300;
    font-weight: 700;
    border-radius: 3px;
  }

  /* Positioning context for menus and sheets drawn on top of the page. */
  .pm__body {
    position: relative;
    flex: 1;
    overflow: hidden;
  }
</style>
