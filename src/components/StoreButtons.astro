---
interface Props {
  align?: 'start' | 'center';
  lang?: 'en' | 'tr';
}
const { align = 'center', lang = 'en' } = Astro.props;
const tr = lang === 'tr';
---

<div class:list={['store-buttons', `store-buttons--${align}`]}>
  <a class="btn" href="https://apps.apple.com/app/rosternado/6766887800">
    {tr ? "App Store'dan indirin" : 'Download on the App Store'}
  </a>
  <a class="btn btn--ghost" href="https://play.google.com/store/apps/details?id=com.inancatil.rosternado">
    {tr ? "Google Play'den edinin" : 'Get it on Google Play'}
  </a>
</div>

<style>
  .store-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .store-buttons--center {
    justify-content: center;
  }

  .store-buttons--start {
    justify-content: flex-start;
  }
</style>
